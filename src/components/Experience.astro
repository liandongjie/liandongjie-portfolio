---
import type { Profile } from '../data/profile';
import type { Ui } from '../i18n/ui';

interface Props {
  profile: Profile;
  ui: Ui;
}

const { profile, ui } = Astro.props;
---

<section class="content-section section-shell" id="experience" aria-labelledby="experience-title">
  <div class="section-heading reveal">
    <p class="section-index">01 / EXPERIENCE</p>
    <h2 id="experience-title">{ui.sections.experience}</h2>
  </div>
  <ol class="experience-list">
    {profile.experience.map((item) => (
      <li class="experience-item reveal">
        <article>
          <div class="experience-primary">
            <h3>{item.company}</h3>
            {item.companyOriginal && <p class="experience-company-original">{item.companyOriginal}</p>}
            <p>{item.role}</p>
          </div>
          <div class="experience-meta">
            <p>{item.location}</p>
            <p>{item.period}</p>
          </div>
        </article>
      </li>
    ))}
  </ol>
</section>
