---
import { localeMeta, type Locale } from '../i18n/config';
import { getUi } from '../i18n/ui';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  page?: 'home' | 'article';
}

const { locale, page = 'home' } = Astro.props;
const ui = getUi(locale);
const homeHref = localeMeta[locale].homePath;
const resolveNavHref = (href: string) => `${homeHref}${href}`;
const englishLabel = page === 'article' ? 'EN Home' : 'EN';
const englishAriaLabel = page === 'article' ? ui.nav.englishHomeLabel : ui.nav.englishLabel;
---

<header class="site-header">
  <div class="nav-shell">
    <a class="wordmark" href={homeHref} aria-label={ui.nav.homeLabel}>DONGJIE</a>

    <nav class="desktop-nav" aria-label={ui.nav.mainLabel}>
      {ui.nav.items.map((item) => <a href={resolveNavHref(item.href)}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <nav class="language-switch" aria-label={ui.nav.languageLabel}>
        <a
          href="/"
          aria-label={ui.nav.chineseLabel}
          aria-current={locale === 'zh-cn' ? 'page' : undefined}
        >中</a>
        <span aria-hidden="true">/</span>
        <a
          href="/en/"
          aria-label={englishAriaLabel}
          aria-current={locale === 'en' ? 'page' : undefined}
        >{englishLabel}</a>
      </nav>
      <ThemeToggle ui={ui} />
      <details class="mobile-nav">
        <summary aria-label={ui.nav.openMenuLabel}>
          <span>{ui.nav.menu}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
        </summary>
        <nav aria-label={ui.nav.mobileLabel}>
          {ui.nav.items.map((item) => <a href={resolveNavHref(item.href)}>{item.label}</a>)}
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const mobileNav = document.querySelector<HTMLDetailsElement>('.mobile-nav');
  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => mobileNav.removeAttribute('open'));
  });
</script>
